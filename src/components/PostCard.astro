---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../lib/posts";

interface Props {
  post: CollectionEntry<"blog">;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
---

<article class:list={["post-card", { featured }]}>
  <a class="post-card-link" href={`/blog/${post.id}/`} aria-label={`阅读：${post.data.title}`}>
    <div class="post-card-meta">
      <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
      <span>{Math.max(1, Math.ceil((post.body?.length ?? 0) / 500))} 分钟阅读</span>
    </div>
    <h3>{post.data.title}</h3>
    <p>{post.data.description}</p>
    <div class="post-card-bottom">
      <div class="tags" aria-label="标签">
        {post.data.tags.slice(0, 3).map((tag) => <span>#{tag}</span>)}
      </div>
      <span class="read-arrow" aria-hidden="true">↗</span>
    </div>
  </a>
</article>
