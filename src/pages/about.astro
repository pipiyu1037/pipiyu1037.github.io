---
import BaseLayout from "../layouts/BaseLayout.astro";
import { resume, siteConfig } from "../config";

const socialLinks = [
  { label: "GitHub", href: siteConfig.socials.github },
  { label: "X", href: siteConfig.socials.x },
  { label: "LinkedIn", href: siteConfig.socials.linkedin },
].filter((item) => item.href);
---

<BaseLayout title={`关于 · ${siteConfig.name}`} description={`关于 ${siteConfig.name}。`}>
  <section class="about shell">
    <div class="about-heading reveal">
      <p class="eyebrow"><span>IDENTITY</span> / ABOUT</p>
      <h1>关于我</h1>
    </div>

    <div class="about-grid">
      <aside class="profile-card reveal delay-1">
        <div class:list={["profile-avatar", { "has-image": siteConfig.avatar }]} aria-hidden="true">
          {siteConfig.avatar ? <img src={siteConfig.avatar} alt="" /> : siteConfig.name.slice(0, 1).toUpperCase()}
        </div>
        <h2>{siteConfig.name}</h2>
        <p>{siteConfig.role}</p>
        <dl>
          <div><dt>位置</dt><dd>{siteConfig.location}</dd></div>
          <div><dt>主页</dt><dd>pipiyu1037.github.io</dd></div>
        </dl>
      </aside>

      <div class="about-content reveal delay-2">
        {siteConfig.about.map((paragraph) => <p>{paragraph}</p>)}
        <div class="contact-block">
          <h2>找到我</h2>
          <div class="contact-links">
            {socialLinks.map((item) => <a href={item.href} target="_blank" rel="noreferrer">{item.label} <span>↗</span></a>)}
            {siteConfig.email && <a href={`mailto:${siteConfig.email}`}>Email <span>↗</span></a>}
          </div>
        </div>
      </div>
    </div>

    <div class="resume-block">
      <div class="resume-block-heading">
        <div>
          <p class="eyebrow"><span>JOURNEY</span> / EXPERIENCE</p>
          <h2>教育背景与经历</h2>
        </div>
        <span>{resume.name}</span>
      </div>

      <div class="resume-grid">
        <section class="resume-section" aria-labelledby="education-heading">
          <div class="resume-section-heading">
            <p>01</p>
            <h3 id="education-heading">教育背景</h3>
          </div>
          <ol class="resume-list">
            {resume.education.map((item) => (
              <li class="resume-item">
                <p class="resume-period">{item.period}</p>
                <div class="resume-entry-line">
                  <h4>{item.institution}</h4>
                  <p>{item.degree}</p>
                  <span>{item.location}</span>
                </div>
              </li>
            ))}
          </ol>
        </section>

        <section class="resume-section" aria-labelledby="experience-heading">
          <div class="resume-section-heading">
            <p>02</p>
            <h3 id="experience-heading">实习与工作经历</h3>
          </div>
          <ol class="resume-list">
            {resume.experience.map((item) => (
              <li class="resume-item">
                <p class="resume-period">{item.period}</p>
                <div class="resume-entry-line">
                  <h4>{item.organization}</h4>
                  <p>{item.role}</p>
                  {item.location && <span>{item.location}</span>}
                </div>
              </li>
            ))}
          </ol>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>
