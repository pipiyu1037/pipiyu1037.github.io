---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { siteConfig } from "../../config";
import { getPublishedPosts } from "../../lib/posts";

const posts = await getPublishedPosts();
const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
---

<BaseLayout title={`文章 · ${siteConfig.name}`} description={`${siteConfig.name} 的技术文章、学习笔记与思考记录。`}>
  <section class="page-hero shell reveal">
    <p class="eyebrow"><span>ARCHIVE</span> / WRITING</p>
    <h1>文章</h1>
    <p>技术、学习和偶尔冒出的想法。共 {posts.length} 篇记录。</p>
    {tags.length > 0 && (
      <div class="tag-cloud" aria-label="现有标签">
        {tags.map((tag) => <span>#{tag}</span>)}
      </div>
    )}
  </section>

  <section class="archive-list shell">
    {posts.length > 0 ? (
      <div class="post-grid archive-grid">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    ) : (
      <div class="empty-state">还没有公开文章。</div>
    )}
  </section>
</BaseLayout>
