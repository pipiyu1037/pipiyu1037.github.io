---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config";
---

<BaseLayout title={`页面未找到 · ${siteConfig.name}`}>
  <section class="not-found shell">
    <p class="error-code">404</p>
    <h1>信号中断</h1>
    <p>这个页面不存在，或者已经移动到了别处。</p>
    <a class="button primary" href="/">返回首页 <span>→</span></a>
  </section>
</BaseLayout>
